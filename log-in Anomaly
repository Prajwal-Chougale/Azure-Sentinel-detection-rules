# Alert logic for Azure Sentinel
let FailedThreshold =5;
IdentityLogonEvents
| where ActionType == "LogonFailed" and (FailureReason contains "incorrect" or FailureReason contains "invalid" or FailureReason contains "no such" or FailureReason contains "is locked")
| summarize UserCount=dcount(AccountName), Appliction=make_set(Application) ,Users = make_set(AccountName,100) by IPAddress, Location, bin(Timestamp, 5m) | where UserCount >= FailedThreshold

## Note: This is the only code part of it, rest is different conditions which we need to select to configure the alert in the Microsoft Azure Sentinel.
